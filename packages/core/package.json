{
	"name": "@dynamix-layout/core",
	"version": "1.0.1",
	"description": "Dynamix Layout/Core is a JavaScript package for creating dynamic layouts with ease.",
	"keywords": [
		"dynamix-layout",
		"ui",
		"ux"
	],
	"author": "Akash Aman <sir.akashaman@gmail.com> (https://akash.cx)",
	"license": "MIT",
	"funding": [
		{
			"type": "patreon",
			"url": "https://www.patreon.com/akashaman"
		},
		{
			"type": "buymeacoffee",
			"url": "https://www.buymeacoffee.com/akashaman"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/xcode-studio/dynamix-layout.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/xcode-studio/dynamix-layout/issues"
	},
	"homepage": "https://github.com/xcode-studio/dynamix-layout#readme",
	"main": "./dist/core.cjs.js",
	"module": "./dist/core.es.js",
	"browser": "./dist/core.iife.js",
	"types": "./dist/types/index.d.ts",
	"typings": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/core.es.js",
			"require": "./dist/core.cjs.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"CHANGELOG.md",
		"README.md",
		"!**/*.map"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"engines": {
		"node": ">=22.16.0",
		"pnpm": ">=10.13.1"
	},
	"scripts": {
		"dev": "vite build --watch",
		"debug": "vite --debug",
		"clean": "rm -rf dist",
		"build": "pnpm run clean && vite build && cp ../../LICENSE dist/LICENSE",
		"dev:local": "vite",
		"preview": "vite preview",
		"test": "vitest",
		"lint": "eslint . --ext ts,tsx  --max-warnings 0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@repo/eslint-config": "workspace:*",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	}
}
