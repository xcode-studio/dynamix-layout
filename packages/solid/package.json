{
	"name": "@dynamix-layout/solid",
	"version": "1.0.2",
	"description": "A powerful SolidJS component for creating dynamic, resizable, and draggable layouts.",
	"keywords": [
		"solid",
		"layout",
		"resizable",
		"draggable",
		"split-layout",
		"tabs",
		"dynamic-layout",
		"solid-layout",
		"solid-component"
	],
	"author": "Akash Aman <sir.akashaman@gmail.com> (https://akash.cx)",
	"funding": [
		{
			"type": "patreon",
			"url": "https://www.patreon.com/akashaman"
		},
		{
			"type": "buymeacoffee",
			"url": "https://www.buymeacoffee.com/akashaman"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcode-studio/dynamix-layout.git",
		"directory": "packages/solid"
	},
	"bugs": {
		"url": "https://github.com/xcode-studio/dynamix-layout/issues"
	},
	"homepage": "https://github.com/xcode-studio/dynamix-layout#readme",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"style": "./dist/styles.css",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./styles.css": "./dist/styles.css",
		"./style.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"LICENSE",
		"CHANGELOG.md",
		"README.md",
		"!**/*.map"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "vite build --watch",
		"debug": "vite --debug",
		"clean": "rm -rf dist",
		"build": "pnpm run clean && vite build && cp ../../LICENSE dist/LICENSE",
		"dev:local": "vite",
		"preview": "vite preview",
		"lint": "eslint . --ext ts,tsx",
		"test": "vitest"
	},
	"license": "MIT",
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/jest-dom": "^6.9.1",
		"jsdom": "^26.1.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-plugin-solid": "2.11.14",
		"vitest": "^4.1.11",
		"solid-js": "^1.9.15"
	},
	"dependencies": {
		"@dynamix-layout/core": "workspace:^"
	},
	"peerDependencies": {
		"solid-js": "^1.8.0"
	}
}
