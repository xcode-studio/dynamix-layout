{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["DOM", "ESNext"],
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"outDir": "./dist",
		"moduleResolution": "Node",
		"allowSyntheticDefaultImports": true,
		"noImplicitAny": true,
		"paths": {
			"@dynamix-layout/core": ["../core/src"],
			"@dynamix-layout/core/*": ["../core/src/*"]
		},
		"baseUrl": ".",
		"types": ["vitest/globals", "@testing-library/jest-dom", "solid-js"]
	},
	"include": ["src/**/*", "src/types/**/*"],
	"exclude": ["node_modules"]
}
